{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "midadea-org-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Ghim sẵn KV namespace đã tồn tại. Không ghim thì @astrojs/cloudflare
	// tiêm binding SESSION không kèm id, wrangler đi tạo namespace mới tên
	// "midadea-org-site-session" và đâm vào cái đã có (API 10014).
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "dbadfa8519c146dc9d77c4028c8bf80c",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "midadea-org-site","database_id": "6df51875-b945-4f89-b095-c93a84301372",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "midadea-org-site","preview_bucket_name": "midadea-org-site",
		},
	],
	// General maintenance plus the bounded Media Usage lane (see src/worker.ts).
	// Giãn từ mỗi phút xuống 5 và 15 phút: blog một tác giả không cần
	// nhịp một phút, và mỗi lần cron chạy đều tính vào hạn mức request.
	"triggers": {
		"crons": ["*/5 * * * *", "*/15 * * * *"],
	},
}
